{
  "name": "sudare-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p sudare-wasm --target wasm32-unknown-unknown --release --config profile.release.strip=false && wasm-bindgen --target web --out-dir src/wasm ../target/wasm32-unknown-unknown/release/sudare_wasm.wasm",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && VITE_STANDALONE=1 vite build --outDir dist-standalone",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
