# Copy to deploy/.env (never commit it). Only SUDARE_SECRET_KEY is required.

# 64 hex chars: `docker run --rm ghcr.io/amirdeshsu/sudare:edge keygen`
SUDARE_SECRET_KEY=
# edge (main branch) or a release, e.g. 0.2.0
SUDARE_VERSION=edge

# single: one login token, printed in the logs. multi: accounts; the first admin uses
# SUDARE_ADMIN_PASSWORD (12+ chars).
SUDARE_MODE=single
SUDARE_ADMIN_PASSWORD=
SUDARE_RETENTION_DAYS=30

# TLS profile (docker compose --profile tls). Clients use https://$SUDARE_DOMAIN.
SUDARE_DOMAIN=
SUDARE_TLS=internal
# With TLS on, set these to match:
# SUDARE_ALLOWED_HOSTS=sudare.corp.example.com
# SUDARE_COOKIE_SECURE=true

# Optional, read-only FortiSIEM connector
SUDARE_FORTISIEM_URL=
SUDARE_FORTISIEM_CLIENT_ID=
SUDARE_FORTISIEM_CLIENT_SECRET=
SUDARE_FORTISIEM_TOKEN=
