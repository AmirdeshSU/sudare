# Copy to .env (never commit it) and export, or set these in your shell.
# Every key is optional: Ollama needs none, and threat-intel providers without a key
# simply don't run.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SUDARE_OPENAI_COMPAT_KEY=

# Threat intel (lookups of public indicators only)
SUDARE_VIRUSTOTAL_KEY=
SUDARE_ABUSEIPDB_KEY=
SUDARE_OTX_KEY=
SUDARE_ABUSECH_KEY=
SUDARE_GREYNOISE_KEY=

# Optional
# SUDARE_POLICY=./sudare.toml
# SUDARE_MAPPINGS_DIR=./mappings
# SUDARE_LOCAL_HOSTS=gpu-box.lan
# SUDARE_CACHE_DIR=~/.cache/sudare
