# Copy to .env (never commit it) and export, or set these in your shell.
# Every key is optional: Ollama needs none, and threat-intel providers without a key
# simply don't run.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SUDARE_OPENAI_COMPAT_KEY=

# Threat intel (lookups of public indicators only)
SUDARE_VIRUSTOTAL_KEY=
SUDARE_ABUSEIPDB_KEY=
SUDARE_OTX_KEY=
SUDARE_ABUSECH_KEY=
SUDARE_GREYNOISE_KEY=

# SIEM connectors (read-only)
# SUDARE_FORTISIEM_URL=https://fortisiem.example.com
# SUDARE_FORTISIEM_CLIENT_ID=
# SUDARE_FORTISIEM_CLIENT_SECRET=
# SUDARE_FORTISIEM_TOKEN=

# Optional
# SUDARE_POLICY=./sudare.toml
# SUDARE_MAPPINGS_DIR=./mappings
# SUDARE_LOCAL_HOSTS=gpu-box.lan
# SUDARE_CACHE_DIR=~/.cache/sudare

# Server (sudare serve / docker compose; compose reads deploy/.env.example instead)
# Required. 64 hex chars from `sudare keygen`. Seals stored keys and mask maps: lose it and
# the stored data is unreadable. Back it up apart from the data directory.
SUDARE_SECRET_KEY=
# single (default): one login token, printed at startup. multi: accounts.
# SUDARE_MODE=single
# SUDARE_TOKEN=            # single mode: 32+ chars; random per start when unset
# SUDARE_ADMIN_PASSWORD=   # multi mode: first admin, 12+ chars
# SUDARE_RETENTION_DAYS=30
# SUDARE_BIND=127.0.0.1:8080
# SUDARE_ALLOWED_HOSTS=sudare.corp.example.com   # required when not bound to loopback
# SUDARE_COOKIE_SECURE=true                      # behind TLS
# SUDARE_DATA_DIR=~/.local/share/sudare          # SQLite database lives here
# SUDARE_OLLAMA_URL=http://127.0.0.1:11434
# SUDARE_OPENAI_COMPAT_URL=
# SUDARE_OPENAI_COMPAT_MODEL=
